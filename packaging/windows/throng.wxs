<?xml version="1.0" encoding="UTF-8"?>
<!--
  throng's Windows installer (WiX v5). A per-user package: it installs to
  %LOCALAPPDATA%\Programs\throng without administrator rights, adds a Start menu
  shortcut, and upgrades an older throng in place. packaging/package.sh builds it
  with: wix build throng.wxs -d Version=<x.y.z> -d BinDir=<dir of throng.exe> -d Root=<repo>
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="throng"
           Manufacturer="throng contributors"
           Version="$(Version)"
           UpgradeCode="b944b00b-b1ab-4bf1-864e-ea76183e18c2"
           Scope="perUser"
           Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="A newer version of throng is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- A per-user package gets no Program Files redirection: it names the per-user folder itself. -->
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="throng" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <!-- Per-user components are kept by an HKCU value, as Windows Installer expects. A component
         with files and a registry key path needs a fixed GUID; these must never change. -->
    <Component Id="Program" Directory="INSTALLFOLDER" Guid="9f028e8b-dce7-4311-b65e-4d62f678990e">
      <File Id="ThrongExe" Source="$(BinDir)\throng.exe" />
      <File Id="License" Source="$(Root)\LICENSE" Name="LICENSE.txt" />
      <File Id="Notice" Source="$(Root)\NOTICE" Name="NOTICE.txt" />
      <File Id="Readme" Source="$(Root)\README.md" Name="README.md" />
      <RegistryValue Root="HKCU" Key="Software\throng" Name="InstallFolder" Type="string"
                     Value="[INSTALLFOLDER]" KeyPath="yes" />
      <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
      <RemoveFolder Id="RemoveProgramsFolder" Directory="ProgramsFolder" On="uninstall" />
    </Component>

    <Component Id="StartMenu" Directory="ProgramMenuFolder" Guid="3a6a71a9-c17b-40c0-9ac2-805f10f78bce">
      <Shortcut Id="StartMenuShortcut" Name="throng" Description="Project-first terminal and editor workspace"
                Target="[INSTALLFOLDER]throng.exe" WorkingDirectory="INSTALLFOLDER" />
      <RegistryValue Root="HKCU" Key="Software\throng" Name="StartMenuShortcut" Type="integer" Value="1"
                     KeyPath="yes" />
    </Component>

    <Feature Id="Main">
      <ComponentRef Id="Program" />
      <ComponentRef Id="StartMenu" />
    </Feature>
  </Package>
</Wix>
